{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65"
  },
  "skillListingMaxDescChars": 1536,
  "skillListingBudgetFraction": 0.01,
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/statusline.js\""
  },
  "permissions": {
    "deny": [
      "Edit(.aiad/hooks/**)",
      "Write(.aiad/hooks/**)",
      "Edit(.aiad/hook-bypass.yml)",
      "Write(.aiad/hook-bypass.yml)",
      "Edit(.aiad/hooks-config.json)",
      "Write(.aiad/hooks-config.json)",
      "Edit(.aiad/hooks-config.local.json)",
      "Write(.aiad/hooks-config.local.json)",
      "Edit(.aiad/gouvernance/**)",
      "Write(.aiad/gouvernance/**)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)"
    ],
    "ask": [
      "Edit(.aiad/config.yml)",
      "Write(.aiad/config.yml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/session-start.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/discovery-gate.js\"",
            "statusMessage": "Prérequis Discovery — phase Research…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/jnsp-scan.js\"",
            "statusMessage": "Garde-fou JNSP — scan TODO-JNSP…"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/veto.js\"",
            "statusMessage": "Veto Tier 1 — zones réglementées…"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/skill-usage.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.aiad/hooks/drift-lock.js\"",
            "statusMessage": "Drift Lock — vérification traçabilité…",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
